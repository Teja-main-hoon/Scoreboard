{
  "name": "scoreboard-overlay",
  "version": "1.0.0",
  "description": "A scoreboard overlay that displays team scores on top of Google Slides",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "start-browser": "open index.html",
    "serve": "python3 -m http.server 8000",
    "package-mac-arm64": "electron-packager . \"Scoreboard Overlay\" --overwrite --platform=darwin --arch=arm64 --prune=true --out=release-builds",
    "package-win": "electron-packager . \"Scoreboard Overlay\" --overwrite --platform=win32 --arch=x64 --prune=true --out=release-builds --no-win32metadata"
  },
  "keywords": [
    "scoreboard",
    "overlay",
    "google-sheets",
    "presentation"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^27.3.11",
    "electron-packager": "^17.1.2"
  }
}
